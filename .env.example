# Local backend environment. Copy to .env at the repository root; never commit real keys.
# Interview coaching provider: groq (default, Slate's chosen provider) or gemini.
# The selected provider's key is only ever sent to that provider's endpoint.
# With the default, a leftover GEMINI_API_KEY never reroutes data to Gemini.
SLATE_INTERVIEW_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq key: AI resume tailoring, and interview coaching in the default provider mode.
LLM_API_KEY=
# Local development only. Never enable this on a public deployment.
SLATE_DEV_AUTH=1
# Optional durable local state; omit to use an ephemeral in-memory store.
SLATE_STATE_URL=sqlite:///slate_state.db
